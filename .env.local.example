# ===== Supabase Configuration =====
# URL project Supabase Anda (bisa diakses publik, aman untuk frontend)
NEXT_PUBLIC_SUPABASE_URL=https://iquxhhcxpqikceosnwfr.supabase.co

# Service role key (SERVER-SIDE ONLY - JANGAN expose ke client/browser!)
# Dapatkan dari: Supabase Dashboard > Project Settings > API > service_role secret
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Secret token untuk proteksi endpoint keep-alive
# Generate string acak yang panjang, contoh: openssl rand -hex 32
CRON_SECRET=your-random-secret-here
